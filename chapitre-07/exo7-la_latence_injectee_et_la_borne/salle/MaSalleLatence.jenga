# MaSalleLatence — chapitre 07, exercice 7 : la latence injectee et la borne.
#
# Le kit Nkentseu vit HORS de ce depot : une seule ligne a changer si on le
# deplace ou si on le met a jour.

from Jenga import *

KIT = "C:/Nkentseu/NkentseuKit.jenga"

with workspace("MaSalleLatenceWks"):
    configurations(["Debug", "Release"])

    useconfig(KIT)              # en-tetes, dossiers de bibliotheques, ordre de lien

    with project("MaSalleLatence"):
        windowedapp()           # application a fenetre : pas de console derriere
        language("C++")
        cppdialect("C++17")
        files(["src/**.cpp"])
        usenkentseukit()        # fonction ecrite par `jenga kit`
